<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<!-- Hibernate mapping for AssessmentSubjectMaster -->
<hibernate-mapping>
    <class name="org.ideoholic.curium.model.assessmentsubjectdetails.dto.AssessmentSubjectMaster" table="assessmentsubjectmaster" >
        <id name="subjectid" type="java.lang.Integer">
            <column name="subjectid" />
            <generator class="native" />
        </id>
        <property name="subjectname" type="string">
            <column name="subjectname" length="100" />
        </property>
         <property name="category" type="string">
            <column name="category" length="100" />
        </property>
        <property name="branchid" type="int">
            <column name="branchid" />
        </property>
        <property name="userid" type="int">
	 			<column name="userid" />
			</property>
    </class>
</hibernate-mapping>
