<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="org.ideoholic.curium.model.mess.item.dto.PoMaster" table="po_master">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="branchId" type="int">
            <column name="branchid"  />
        </property>
        <property name="externalId" type="string">
            <column name="externalid" length="45" />
        </property>
         <property name="supplierId" type="int">
            <column name="supplierid" />
        </property>
        <property name="entryDate" type="date">
            <column name="entrydate" length="10"  />
        </property>
         <property name="totalItem" type="int">
            <column name="totalitem" />
        </property>
        <property name="totalQuantityOrdered" type="int">
            <column name="totalquantityordered" />
        </property>
                
    </class>
</hibernate-mapping>
