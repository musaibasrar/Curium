<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<!-- Hibernate mapping for HolisticAssessment -->
<hibernate-mapping>
    <class name="org.ideoholic.curium.model.assessmentdetails.dto.HolisticAssessment" table="holisticassessment">
        <id name="assessmentid" type="java.lang.Integer">
            <column name="assessmentid" />
            <generator class="identity" />
        </id>
        <property name="assessmentname" type="string">
            <column name="assessmentname" length="45" />
        </property>
        <property name="branchid" type="int">
            <column name="branchid" />
        </property>
        <property name="userid" type="int">
 			<column name="userid" />
		</property>
    </class>
</hibernate-mapping>
