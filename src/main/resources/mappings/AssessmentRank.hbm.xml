<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<!-- Hibernate mapping for AssessmentRank -->
<hibernate-mapping>
    <class name="org.ideoholic.curium.model.ratingdetails.dto.AssessmentRank" table="assessmentrank">
        <id name="id" type="java.lang.Integer">
            <column name="id" />
            <generator class="identity" />
        </id>
        <property name="sid" type="java.lang.Integer">
            <column name="sid" />
        </property>
        <property name="assessmentid" type="java.lang.Integer">
            <column name="assessmentid" />
        </property>
        <property name="ratingobtained" type="java.lang.Float">
            <column name="ratingobtained" />
        </property>
        <property name="academicyear" type="java.lang.String">
            <column name="academicyear" />
        </property>
        <property name="status" type="java.lang.String">
            <column name="status" />
        </property>
        <property name="rank" type="int">
            <column name="rank" />
        </property>
        <property name="branchid" type="int">
            <column name="branchid" />
        </property>
        <property name="userid" type="int">
	 			<column name="userid" />
			</property>
    </class>
</hibernate-mapping>
