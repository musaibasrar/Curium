FROM tomcat:9.0-jdk17-openjdk

# Remove default webapps so our app is served as ROOT (or named path)
RUN rm -rf /usr/local/tomcat/webapps/*

# Allow overriding the path to the WAR produced by the host build
ARG WAR_FILE=target/*.war
# Copy the WAR built on the host into the image and name it school.war
COPY ${WAR_FILE} /usr/local/tomcat/webapps/school.war

EXPOSE 8080

CMD ["catalina.sh", "run"]